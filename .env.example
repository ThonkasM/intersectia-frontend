# Opcionales: si no se definen, la app usa el mismo origen (window.location.origin),
# que es lo que se usa al desplegar con nginx haciendo de proxy (Docker/EC2).
# En local conviene apuntarlas al backend.
NEXT_PUBLIC_WS_URL="ws://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Opcional: URL pública del sitio (metadataBase / Open Graph). En producción, el
# dominio de CloudFront. Si no se define, se usa http://localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://tu-dominio"
